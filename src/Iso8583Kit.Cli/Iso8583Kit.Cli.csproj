<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <AssemblyName>Iso8583Kit.Cli</AssemblyName>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>iso8583</ToolCommandName>
    <PackageId>Iso8583Kit.Cli</PackageId>
    <Version>0.1.0</Version>
    <Authors>Vong Visalsambath</Authors>
    <Description>Read, build and send ISO 8583 messages, and run a simulated card host for testing.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/vongvisalsambath/iso8583kit</RepositoryUrl>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Iso8583Kit/Iso8583Kit.csproj" />
    <InternalsVisibleTo Include="Iso8583Kit.Tests" />
  </ItemGroup>
</Project>
